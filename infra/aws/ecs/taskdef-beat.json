{
  "family": "sentinel-beat",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::<ACCOUNT_ID>:role/sentinelTaskRole",
  "containerDefinitions": [
    {
      "name": "sentinel-beat",
      "image": "<ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/sentinel-backend:latest",
      "essential": true,
      "command": [
        "celery",
        "-A",
        "app.workers.celery_app",
        "beat",
        "--loglevel=info"
      ],
      "environment": [
        { "name": "APP_NAME", "value": "Sentinel" },
        { "name": "APP_VERSION", "value": "1.0.0" },
        { "name": "DEBUG", "value": "false" },
        { "name": "ENVIRONMENT", "value": "production" },
        { "name": "ALERT_AUTO_DEACTIVATE_DAYS", "value": "7" },
        { "name": "ALERT_DELETE_AFTER_DAYS", "value": "90" }
      ],
      "secrets": [
        { "name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:sentinel/prod/database-url" },
        { "name": "REDIS_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:sentinel/prod/redis-url" },
        { "name": "CELERY_BROKER_URL", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:sentinel/prod/celery-broker-url" },
        { "name": "CELERY_RESULT_BACKEND", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:sentinel/prod/celery-result-backend" },
        { "name": "OPENWEATHER_API_KEY", "valueFrom": "arn:aws:secretsmanager:<REGION>:<ACCOUNT_ID>:secret:sentinel/prod/openweather-api-key" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/sentinel",
          "awslogs-region": "<REGION>",
          "awslogs-stream-prefix": "beat"
        }
      }
    }
  ]
}
